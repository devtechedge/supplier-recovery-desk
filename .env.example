# Application Base URL (used for auth callbacks, Stripe return URLs, and links)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing secret (required in production; falls back to ephemeral/local dev secret only in non-production)
AUTH_SESSION_SECRET="replace-with-a-32-plus-character-random-secret"

# Supabase (Managed PostgreSQL, Auth, and Private Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Stripe Billing (Optional — runs in explicit Development Billing Mode when unset)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRICE_STARTER="price_starter_monthly"
STRIPE_PRICE_GROWTH="price_growth_monthly"
STRIPE_PRICE_SCALE="price_scale_monthly"

# Transactional Email (Resend — Optional; drafts can always be copied/exported without email sending)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="claims@your-verified-domain.example"

# Gemini AI Assistance (Optional — server-side only; deterministic workflows work without AI)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
